{
  "private": true,
  "name": "claude-training",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@repo/api",
    "dev:web": "turbo run dev --filter=@repo/web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@repo/api",
    "build:web": "turbo run build --filter=@repo/web",
    "start": "turbo run start",
    "start:api": "turbo run start --filter=@repo/api",
    "start:web": "turbo run start --filter=@repo/web",
    "worker:report-email": "turbo run worker:report-email --filter=@repo/api",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "format": "turbo run format",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "5.9.3"
  }
}
