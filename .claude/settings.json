{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(git push *main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main-push.sh"
          }
        ]
      }
    ]
  }
}
