#!/bin/sh
# Husky pre-push hook: blocks pushes to main and non-fast-forward updates.
# Git invokes: pre-push <remote_name> <remote_url>
# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per ref
# Note: original --force flags are NOT passed to this hook; non-fast-forward
# is detected via ancestry (merge-base --is-ancestor), not flag inspection.
# Force-flag blocking for the raw command is handled by the Claude Code
# PreToolUse hook; GitLab branch protection is the authoritative gate.

remote_name="$1"
remote_url="$2"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip empty lines (no refs pushed)
  [ -z "$local_ref" ] && continue
  [ -z "$remote_ref" ] && continue

  # 1. Block any push to refs/heads/main
  case "$remote_ref" in
    refs/heads/main)
      echo "Blocked: direct pushes to main are not allowed (use a feature branch and a merge request)." >&2
      blocked=1
      ;;
  esac

  # 2. Reject non-fast-forward updates (would require --force).
  # New branch: remote_sha is all zeros — not a rewrite, skip ancestry check.
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  # Deleted ref: local_sha is all zeros — not a push, skip.
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  # If remote commit is not an ancestor of local commit, this is non-fast-forward
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "Blocked: non-fast-forward update to $remote_ref — force pushes are not allowed." >&2
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi
exit 0
