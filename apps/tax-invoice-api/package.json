{
  "name": "@repo/api",
  "version": "1.0.0",
  "description": "Tax Invoice system",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "dev:worker": "tsx watch src/workers/report-email.worker.ts",
    "worker:report-email": "node dist/workers/report-email.worker.js",
    "lint": "eslint src --fix && prettier src --write",
    "lint:check": "eslint src && prettier src --check",
    "check": "tsc --noEmit && eslint src && prettier src --check && jest --coverage=false",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --coverage",
    "migration:create": "migrate-mongo create",
    "migration:up": "migrate-mongo up",
    "migration:down": "migrate-mongo down",
    "migration:status": "migrate-mongo status"
  },
  "keywords": [],
  "author": "Ngan Tong",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "effect": "^3.21.4",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "express-oauth2-jwt-bearer": "^1.9.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "migrate-mongo": "^14.0.7",
    "mongoose": "^8.16.2",
    "nodemailer": "^9.0.0",
    "pdfkit": "^0.19.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-jwt": "^7.4.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.30.1",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^16.3.0",
    "jest": "^30.0.4",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "5.9.3"
  }
}
